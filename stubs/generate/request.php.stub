<?php

namespace App\Http\Requests;

use Rhino\Http\Requests\ResourceRequest;

/**
 * Validation for {{ actionVerb }} on the {{ modelName }} resource.
 *
 * Rhino finds this class by convention — {{ modelName }}{{ actionSuffix }}Request in the
 * namespace configured by `rhino.requests.namespace` — and runs it for
 * {{ httpCall }} instead of the model's own $validationRules.
 *
 * Everything in the context is reachable through a helper:
 *
 *   $this->user()          the authenticated user (null when unauthenticated)
 *   $this->organization()  the resolved tenant (null outside a tenant group)
 *   $this->routeGroup()    the matched route's group, e.g. 'tenant' or 'public'
 *   $this->action()        '{{ action }}'
 *   $this->record()        {{ recordDoc }}
 *
 * IMPORTANT — what you validate is what gets written. Only the keys covered by
 * a rule that passed are persisted; a field with no rule is dropped silently,
 * not saved. So declare a rule for EVERY field this action should write, even
 * if the rule is as loose as 'nullable'.
 */
class {{ className }} extends ResourceRequest
{
    /**
     * Reject the whole request (403) before any rule runs.
     *
     * The response is byte-identical to a policy denial on purpose, so a client
     * cannot tell the two apart. Returning false is all you can do — a custom
     * message would leak why.
     *
     * Field-level permissions belong in the policy
     * (permittedAttributesFor{{ policySuffix }}), not here.
     */
