    //
    //     // Bad: launders a client value into a field the policy may deny.
    //     // $input['owner_id'] = $input['user_id'] ?? $this->user()?->id;
    //
    //     return $input;
    // }

    /**
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
            // ---------------------------------------------------------------
            // Format rules. Declare one line per field this action writes.
            // ---------------------------------------------------------------
            // 'title' => '{{ presence }}|string|max:255',
            // 'description' => 'nullable|string',

            // ---------------------------------------------------------------
            // Foreign keys: `exists:` is scoped to the current organization
            // automatically, including for models that reach their
            // organization through a relationship rather than a column. Write
            // the plain rule — do NOT add ',organization_id,N' yourself.
            // ---------------------------------------------------------------
            // 'project_id' => '{{ presence }}|integer|exists:projects,id',

            // ---------------------------------------------------------------
            // Role-dependent rules: branch on the user instead of keying a map
            // by role slug.
            // ---------------------------------------------------------------
            // 'status' => $this->user()?->getRoleSlugForValidation($this->organization()) === 'admin'
            //     ? '{{ presence }}|string'
            //     : '{{ presence }}|in:todo,doing',

            // ---------------------------------------------------------------
            // Route-group-dependent rules: the same model reached from two
            // groups can require different things.
            // ---------------------------------------------------------------
            // 'assignee_id' => $this->routeGroup() === 'admin'
            //     ? 'nullable|integer|exists:users,id'
            //     : 'prohibited',

            // ---------------------------------------------------------------
            // Record-dependent rules: {{ recordRuleDoc }}
            // ---------------------------------------------------------------
            {{ recordRuleExample }}
        ];
    }

