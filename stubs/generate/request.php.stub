    /**
     * Normalize the input before authorize(), the rules and the write payload
     * see it.
     *
     * This runs AFTER the policy's forbidden-field check, which inspects
     * exactly what the client sent — so nothing here can launder a field past
     * the policy. Whatever you add is server-authored and trusted: set it from
     * server state, never by copying a client value into another key.
     *
     * A key added here is still only persisted if a rule below covers it.
     *
     * prepare() runs BEFORE the rules, so the input is still whatever the client
     * sent — including arrays and nulls where you expected a string. Guard every
     * cast: trim(['x']) is a fatal "Array to string conversion", not a 422.
     */
    // public function prepare(array $input): array
    // {
    //     if (is_string($input['title'] ?? null)) {
    //         $input['title'] = trim($input['title']);
    //     }
    //
    //     // Good: server-authored value.
